# Copier ce fichier en .env puis adapter les valeurs.
# .env n'est jamais versionné.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel
POSTGRES_DB=travel
POSTGRES_PORT=5432

# Backend
# DATABASE_URL sert aux outils lancés sur la machine (localhost) ; le conteneur
# backend reçoit sa propre URL (hôte `db`) depuis docker-compose.yml.
DATABASE_URL=postgres://travel:travel@localhost:5432/travel?sslmode=disable
API_PORT=8080
# Vides : valeurs par défaut du backend (100 requêtes/min par IP, 1 Mo).
# APP_ENV=production active HSTS.
APP_ENV=
RATE_LIMIT_PER_MINUTE=
MAX_BODY_BYTES=

# Frontend
FRONTEND_PORT=5173
