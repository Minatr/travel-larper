# Copier ce fichier en .env puis adapter les valeurs. .env n'est jamais versionné.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel
POSTGRES_DB=travel
POSTGRES_PORT=5432

# Backend
# DATABASE_URL sert aux outils lancés sur la machine (localhost) ; le conteneur backend reçoit sa propre URL (hôte `db`)
# depuis docker-compose.yml.
DATABASE_URL=postgres://travel:travel@localhost:5432/travel?sslmode=disable
API_PORT=8080
# Vides : valeurs par défaut du backend (100 requêtes/min par IP, 1 Mo, 10 inscriptions/heure par IP).
# APP_ENV=production active HSTS.
APP_ENV=
RATE_LIMIT_PER_MINUTE=
MAX_BODY_BYTES=
REGISTER_RATE_LIMIT_PER_HOUR=
LOGIN_RATE_LIMIT_PER_MINUTE=
LOGIN_FAILURES_PER_ACCOUNT_PER_HOUR=
SESSION_IDLE_TIMEOUT_HOURS=

# Scripts de données (jamais lus par le backend ; clés jamais dans Git).
# REST Countries : seulement pour `make country-data` (monnaies et langues des fiches pays, une ou deux fois par an).
# Clé gratuite sur restcountries.com, de la forme rc_live_… ; le forfait gratuit permet 1 000 requêtes par mois.
RESTCOUNTRIES_API_KEY=

# Frontend
FRONTEND_PORT=5173
