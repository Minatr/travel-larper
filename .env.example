# Copier ce fichier en .env puis adapter les valeurs.
# .env n'est jamais versionné.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel
POSTGRES_DB=travel
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgres://travel:travel@localhost:5432/travel?sslmode=disable
API_PORT=8080

# Frontend
FRONTEND_PORT=5173
